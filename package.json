{
    "name": "fizzy",
    "description": "A tasty blogging theme for Ghost.",
    "version": "1.3.6",
    "author": {
        "name": "Yuzhang Huang",
        "email": "huangyuzhang@live.cn"
    },
    "engines": {
        "ghost": ">=5.0.0"
    },
    "keywords": [
        "ghost",
        "theme",
        "ghost-theme"
    ],
    "dependencies": {},
    "config": {
        "posts_per_page": 8,
        "image_sizes": {
            "icon": {
                "width": 64
            },
            "small": {
                "width": 300
            },
            "medium": {
                "width": 600
            },
            "large": {
                "width": 900
            },
            "wide": {
                "width": 1200
            }
        },
        "custom": {
            "title_font": {
                "type": "select",
                "options": [
                    "Montserrat",
                    "serif",
                    "sans-serif"
                ],
                "default": "Montserrat"
            },
            "body_font": {
                "type": "select",
                "options": [
                    "Georgia",
                    "serif",
                    "sans-serif"
                ],
                "default": "Georgia"
            }
        }
    }
}
